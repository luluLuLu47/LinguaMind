# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ===== 本地数据库与备份（含用户数据，绝不推送）=====
/data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/

# ===== 日志与运行产物 =====
*.log
run-server.cmd
启动服务.bat

# ===== 本地工具 =====
*.exe

# ===== 文档：只保留 README =====
*.md
!README.md
